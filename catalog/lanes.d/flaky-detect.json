{
  "id": "flaky-detect",
  "name": "Flaky test detector",
  "scope": "hub",
  "script": "bin/flaky-detect.sh",
  "cadence": "40 5 * * *",
  "boxes": [
    "hub"
  ],
  "switch": {
    "kind": "flag",
    "name": "lane-off-flaky-detect",
    "aliases": []
  },
  "wired": true,
  "knobs": [
    {
      "env": "FLAKY_PAGES",
      "type": "int",
      "default": 5,
      "zero_means": null,
      "note": "Read by bin/flaky-detect.sh as ${FLAKY_PAGES:-5}. Registered by BH-1165 so it is visible and settable; no reviewed min/max yet, so nothing is clamped."
    }
  ],
  "stats": {
    "cost_stage": null,
    "cost_project_filter": null,
    "lanes_row": false,
    "log": "logs/flaky-detect.log"
  }
}
