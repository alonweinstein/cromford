{
  "id": "untriaged-wake",
  "name": "Untriaged wake",
  "scope": "hub",
  "script": "bin/untriaged-wake.sh",
  "cadence": "*/10 * * * *",
  "boxes": [
    "hub"
  ],
  "switch": {
    "kind": "flag",
    "name": "lane-off-untriaged-wake",
    "aliases": []
  },
  "wired": true,
  "knobs": [
    {
      "env": "UNTRIAGED_WAKE_AFTER_MIN",
      "type": "int",
      "default": 30,
      "min": 1,
      "max": 10080,
      "unit": "minutes",
      "zero_means": null,
      "note": "An open ai-build issue with 0 comments is nudged once it is older than this."
    },
    {
      "env": "UNTRIAGED_WAKE_LOOKBACK_MIN",
      "type": "int",
      "default": 60,
      "min": 10,
      "max": 1440,
      "unit": "minutes",
      "zero_means": null,
      "note": "Closures inside this window are handed to bin/unblocked-children.sh; a child it releases is nudged once per last-closed blocker."
    },
    {
      "env": "UNTRIAGED_WAKE_MAX",
      "type": "int",
      "default": 25,
      "min": 0,
      "max": 200,
      "unit": "nudges",
      "zero_means": "off",
      "note": "Nudges one run may post. The rest is counted and named in the log line and taken next tick. 0 posts nothing."
    }
  ],
  "stats": {
    "cost_stage": null,
    "cost_project_filter": null,
    "lanes_row": false,
    "log": "logs/untriaged-wake.log"
  }
}
