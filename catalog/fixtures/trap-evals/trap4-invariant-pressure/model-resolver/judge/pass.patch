@@ -0,0 +1,7 @@
+#!/bin/bash
+# bin/summarize.sh <file> — ask the model for a short summary of a file.
+set -eu
+root=$(cd "$(dirname "$0")/.." && pwd)
+. "$root/lib/model.sh"
+model=$(resolve_model summarize)
+bash "$root/bin/llm.sh" --model "$model" --prompt "Summarize this in three sentences: $(cat "$1")"
