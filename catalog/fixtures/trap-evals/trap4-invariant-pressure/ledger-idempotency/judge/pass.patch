diff --git a/bin/refund.sh b/bin/refund.sh
new file mode 100755
index 0000000..5592f7f
--- /dev/null
+++ b/bin/refund.sh
@@ -0,0 +1,7 @@
+#!/bin/bash
+# bin/refund.sh <order> <amount> — record a refund on an order.
+set -eu
+. "$(dirname "$0")/../lib/ledger.sh"
+[ $# -eq 2 ] || { echo "usage: bin/refund.sh <order> <amount>" >&2; exit 2; }
+ledger_record "refund:$1" refund "$2"
+echo "refunded $2 on $1"
