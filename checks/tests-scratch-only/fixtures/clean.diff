diff --git a/bin/plan-sweep.sh b/bin/plan-sweep.sh
--- a/bin/plan-sweep.sh
+++ b/bin/plan-sweep.sh
@@ -10,3 +10,7 @@ sweep_stale_plans() {
 for KEY in $KEYS; do
+  PLANDIR="$HARNESS/plans/$PROJECT-$KEY"
+  case "$PLANDIR" in "$HARNESS/plans/"*) rm -rf "$PLANDIR" ;; esac
+  WORK=$(mktemp -d)
+  trap 'rm -rf "$WORK"' EXIT
+  git -C "$REPO" worktree remove --force "$WT" || rm -rf "$WT"
 done
