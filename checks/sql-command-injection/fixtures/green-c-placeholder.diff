diff --git a/worker/jobs/src/routes/initiatives.js b/worker/jobs/src/routes/initiatives.js
--- a/worker/jobs/src/routes/initiatives.js
+++ b/worker/jobs/src/routes/initiatives.js
@@ -1,0 +1,6 @@
+export async function page(env, limit) {
+  const binds = [];
+  binds.push(limit + 1);
+  const sql = `SELECT * FROM initiatives ORDER BY next_check_at ASC, id ASC LIMIT ?${binds.length}`;
+  return (await env.DB.prepare(sql).bind(...binds).all()).results || [];
+}
