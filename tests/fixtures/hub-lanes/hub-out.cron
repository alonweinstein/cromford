SHELL=/bin/bash
*/5 * * * * /root/harness/bin/watchdog-ping.sh

# BEGIN hub-lanes

# this comment and the blank line above it survive verbatim
5 0 * * * /root/harness/bin/hub-lease.sh check && /root/harness/bin/sync-data.sh
50 7 * * * /root/harness/bin/hub-lease.sh check && WINDOWS_ONLY=1 /root/harness/bin/cost-rollup.sh >/dev/null 2>&1
15 6 * * * /root/harness/bin/hub-lease.sh check && for P in one two three; do /root/harness/bin/backup.sh $P >/dev/null 2>&1; done
# END hub-lanes
17 5 * * * /root/harness/bin/update-runners.sh
# BEGIN hub-lanes
30 8 * * * /root/harness/bin/hub-lease.sh check && /root/harness/bin/hub-leased-task.sh
0 3 * * * /root/harness/bin/hub-lease.sh check && /root/harness/bin/merge-conductor.sh
# END hub-lanes
*/5 * * * * /root/harness/bin/keepalive.sh
