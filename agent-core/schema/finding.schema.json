{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/example-org/cromford/agent-core/schema/finding.schema.json",
  "title": "Finding",
  "description": "One thing an agent observed, keyed by fingerprint for dedup.",
  "type": "object",
  "required": [
    "agent",
    "fingerprint",
    "title",
    "source",
    "observedAt"
  ],
  "properties": {
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "url",
        "labels"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filedBy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observedAt": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
