# ---- auditd watcher (#395 slice, BH-443; ON by default) ----
# bin/audit-install.sh puts a kernel audit watch on the harness roots so a
# deletion leaves a record. It runs from bin/update-runners.sh (05:17Z daily) and
# from bin/bootstrap-machine.sh, is idempotent, and exits 0 from every path —
# apt refusing, the daemon refusing to start, or a kernel that will not take the
# rules is a line in logs/audit-install.log plus ONE logs/ALERTS.log line a day.
# Every value below is the code's REAL default; uncomment to override.
# `bin/audit-install.sh --check` prints this box's state and writes nothing.
#
# 0 = do not install, repair or load anything. `flags/audit-off` is the same
# switch as a file, and the tailer slice (BH-444) shares it.
#AUDIT_INSTALL=1
# The trees the kernel watches, space separated. One `-w <root> -p wa -k harness`
# line per root; `bin/audit-install.sh --render` prints exactly what gets written.
#AUDIT_ROOTS="/root/harness /root/orchestrator /etc/harness /root/.ssh"
# The rotation bound. A `-p wa` watch on a tree holding logs/ and builds/ records
# every open-for-write, so these two are what keeps /var/log/audit finite.
#AUDIT_LOG_MB=100
#AUDIT_LOG_KEEP=10
# Where the installer writes, on this box. Overridable so a suite can point the
# whole lane at a scratch tree; on a real box leave them alone.
#AUDIT_RULES_FILE="/etc/audit/rules.d/harness.rules"
#AUDITD_CONF="/etc/audit/auditd.conf"
# How the daemon gets supervised: systemd dir present -> systemctl; else
# supervisord dir present -> a [program:auditd] block; else a bare auditd.
#AUDIT_SUPERVISOR_DIR="/etc/supervisor/conf.d"
#AUDIT_SYSTEMD_DIR="/run/systemd/system"

