# ---- chat transports (hub only) ----
# The hub answers the operator's chat messages; no other box reads these, and
# bin/fly-envbundle.sh never copies them to a builder.
# Telegram: the bot token from @BotFather and the chat the bot replies in when a
# message carries no origin of its own (the "the operator Harness" forum group).
# Both unset = the orchestrator sends nothing to Telegram.
#TELEGRAM_BOT_TOKEN=<bot-token-from-botfather>
#TELEGRAM_CHAT_ID=<-100...>
# Slack (optional): the console Slack app's BOT token (xoxb-...). The hub uses it
# for ONE thing — bin/chat-media.sh downloads a Slack attachment's url_private
# with it. Replies themselves go out through the console, not from here. Unset =
# a Slack attachment is refused with an ALERTS line instead of a broken file.
# Turning the Slack reply path on is a separate, deliberate step:
#   touch /root/harness/flags/orc-reply-via-console     (see docs/OPERATOR-SETUP.md)
#SLACK_BOT_TOKEN=xoxb-<console-slack-app-bot-token>

