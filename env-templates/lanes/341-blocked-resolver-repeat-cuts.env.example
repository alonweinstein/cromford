# ---- blocked-resolver repeat cuts (BH-5946) ----------------------------------
# Three optional modules of bin/blocked-resolver.sh. The settings rows
# lib.br-repeat-cuts.* win over these; the values below are the defaults.
# The `prof:` line after each `tick:` line, and a per-row TSV in
# state/blocked-resolver/profile/. 0 = neither.
#BR_PROFILE=1
# How many per-run profile TSV files are kept (24 = 4 h of */10 runs).
#BR_PROFILE_KEEP=24
# The per-run read memo: one run reads a PR, its issue thread and the merged-PR
# search once. A rung always reads live. 0 = every read goes to GitHub.
#BR_READMEMO=1
# The oldest memo entry a read may use. 0 = the memo is off.
#BR_READMEMO_MAX_AGE_S=300
# The longest time a quiet row (held, escalated, stalled, ...) is skipped while
# nothing local changed. A RESUME comment is seen at most this late. 0 = off.
#BR_UNCHANGED_RECHECK_S=1800
# The quiet exits a row may be skipped after.
#BR_UNCHANGED_CLASSES="held escalated stalled job-abandoned hv-stands rung-hold needs-human ci-parked"
