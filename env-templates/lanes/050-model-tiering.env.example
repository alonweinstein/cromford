# ---- model tiering (optional — these are the defaults) ----
# Edit here to retier; no redeploy needed.
#TRIAGE_MODEL=claude-fable-5
#PLAN_MODEL=claude-fable-5
#EXECUTE_MODEL=claude-opus-5-5
#REVIEW_MODEL=claude-opus-5-5
# The general lens's model on a T0 diff (docs/tests/CI-config only — see
# docs/verification-map/review-tier.md). UNSET MEANS REVIEW_MODEL, so leaving
# this commented reviews T0 exactly where every other tier is reviewed.
#REVIEW_MODEL_T0=
#QA_MODEL=claude-opus-5-5
#CODEX_MODEL=            # empty = codex CLI default (moves with CLI updates)

