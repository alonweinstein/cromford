# ---- Archie wake-ups, quiet hours and the daily beat cap (BH-4063) ----
# bin/archie.sh's tick wakes an initiative on events (an initiative-linked PR
# merge, a replan-escalate, an outcome row, an ALERTS line, a lane over its
# daily budget, a follow-up coming due) and sends every Archie beat through a
# gate. These are knobs on the archie lane (catalog/lanes.d/archie.json), so
# the settings rows lane.archie.<NAME> override what is set here.
# Beats per UTC day before the rest are held for one digest; 0 holds every
# beat and sends one digest a day.
#ARCHIE_BEAT_CAP_DAY=5
# Quiet hours, UTC hours 0-23: from <= hour < to, wrapping midnight when from >
# to (22 and 6 is 22:00Z-06:00Z). Equal values (the default) mean none.
#ARCHIE_QUIET_FROM_H=0
#ARCHIE_QUIET_TO_H=0
# Which ALERTS.log lines wake Archie: 1 only lines naming a linked ticket
# (#N or BH-N), 2 every other line too (on the factory-watch initiative), 0 none.
#ARCHIE_WAKE_ALERT_SCOPE=1
