# ---- external-PR review (optional — on by default) ----
# bin/review-prs.sh re-offers an APPROVE that is still bound to the PR's current
# head to its merge step on every tick, while the PR is OPEN + CLEAN and no hold
# is in force. Without it an APPROVE held on its first tick was never retried by
# anything (project-2 #294/#488/#489 sat open for days). 0 = the old
# behaviour; REVIEW_MERGE_RETRY_MAX caps attempts per head before one ALERT.
#REVIEW_MERGE_RETRY=1
#REVIEW_MERGE_RETRY_MAX=6
# BH-1646. Consecutive base holds (stacked PR, base not main) on one head before
# ONE ALERT naming the base; a new head resets it. 0 = never alert.
#REVIEW_BASE_HOLD_ALERT_TICKS=6
# BH-1017. How many times one head may ENTER a review without a verdict coming
# back (a box reboot, an OOM, a deploy that rolls the lane mid-session) before
# the lane stops buying it and pages. A crashed review is owed exactly one
# retry; a head that dies twice mid-call needs a person, not a third session.
#REVIEW_INFLIGHT_MAX=2

# BH-872 (#891 review round 1). How many consecutive REFUSED dismissals of the
# same standing review page a person. A dismissal the App has no right to make
# on a protected repo is refused every tick for ever; one log line a tick is a
# silence nobody reads, so the Nth failure writes one ALERTS line naming the PR.
#RP_DISMISS_FAIL_ALERT=3
