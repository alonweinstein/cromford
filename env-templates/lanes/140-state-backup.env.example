# ---- state backup (BH-396; the 15-minute off-box copy after the 2026-09-15 hub wipe, #388) ----
# bin/state-backup.sh tars state/, logs/, flags/, the builds/ summaries and the
# orchestrator checkout, encrypts env/ with age and uploads the tarball to an
# S3-compatible bucket (Cloudflare R2). Restore and the operator setup steps land
# in docs/RESTORE.md with the last slice of #396 (not written yet). Placeholders
# only here - the real values live in env/global.env on the box, chmod 600.
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=harness-state
BACKUP_S3_ACCESS_KEY_ID=<r2-token-id>
BACKUP_S3_SECRET_ACCESS_KEY=<r2-token-secret>
BACKUP_S3_REGION=auto
BACKUP_AGE_RECIPIENT=age1<public-key>
#BACKUP_KEEP_ALL_DAYS=7
#BACKUP_KEEP_DAILY_DAYS=30
#STATE_BACKUP=1
#BACKUP_S3_CLIENT=aws
#BACKUP_ZSTD_LEVEL=1
#BACKUP_SKIP_UNCHANGED=1
#BACKUP_FORCE_HOURS=24

