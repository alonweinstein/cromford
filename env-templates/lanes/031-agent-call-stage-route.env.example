# ---- agent-call: the stage.<stage> route read (BH-1837) ---------------------
# Every bin/agent-call.sh call reads its stage.<stage> model route for the
# runner. The answer, "no route" included, is kept on the box in
# state/model-routes/stage-runner/ for this many seconds. 0 = ask on every call.
#AGENT_CALL_STAGE_ROUTE_TTL_S=120
# The longest that read waits for the worker, in seconds, with no retry. On a
# timeout the call runs RUNNER_<STAGE> or claude. Capped at 8 in the registry.
#AGENT_CALL_STAGE_ROUTE_TIMEOUT_S=3
