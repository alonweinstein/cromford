# ---- box launch (operator CLI, BH-5748) ----
# bin/box-launch.sh makes one Orgo box and puts the harness on it. It is not a
# cron lane. These are read only when an operator runs it. The plan limits and
# prices are in catalog/orgo-plans.json, not here.
# Tailscale auth key for `tailscale up` on the new box. SECRET: env only. It
# rides the Orgo bash request body and is never printed or logged.
#BOX_LAUNCH_TS_AUTHKEY=
# The hub public key that goes into the new box's authorized_keys (one ssh- line).
#BOX_LAUNCH_HUB_PUBKEY=/root/.ssh/id_ed25519.pub
# Env files copied to the box when they exist on the hub, besides the required
# global.env and <project>.env. Space-separated names in the env dir.
#BOX_LAUNCH_ENV_FILES_OPTIONAL=github-app.env github-app.pem
# Seconds between status polls while the new computer starts.
#BOX_LAUNCH_POLL_S=15
# Seconds to wait for the computer to report running before the step fails.
#BOX_LAUNCH_DEADLINE_S=900
# Timeout in seconds for one Orgo API call.
#BOX_LAUNCH_CALL_TIMEOUT_S=300
