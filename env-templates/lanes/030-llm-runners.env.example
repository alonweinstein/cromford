# ---- LLM runners (at least one required) ----
# Claude Code auth for headless sessions (claude CLI must be installed).
# Generate with: claude setup-token   (on a machine logged into the right account)
CLAUDE_CODE_OAUTH_TOKEN=<token>
# Optional second runner: codex CLI (auth via ~/.codex/auth.json or CODEX_API_KEY).
# Per-stage runner and failover come from the stage.<stage> model routes
# (model_routes rows, console Model routes page): rung 0 is the runner, rung 1
# the fallback it retries on when the primary dies (cap/auth/crash). A stage
# with no route runs claude. RUNNER_<STAGE> / RUNNER_<STAGE>_FALLBACK set here
# still override the route (bin/agent-call.sh alerts once a day when they differ).
# warn|refuse: what bin/agent-call.sh does when a caller's model family does not
# match the stage's primary runner. warn alerts and runs; refuse stops the call
# (rc 74, nothing billed). Any other value is warn.
AGENT_CALL_MODEL_MISMATCH=warn

