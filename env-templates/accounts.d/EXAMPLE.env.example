# env/accounts.d/<name>.env — ONE account the box may route work to.
#
# Copy this file to /root/harness/env/accounts.d/<name>.env, fill it in, and
# `chmod 600` it. env/ is gitignored fleet-wide: this example is the only part
# that ships. The filename stem MUST equal ACCOUNT_NAME (a file whose stem and
# name disagree is skipped with a registry_skip line in
# logs/account-routing.log). `default.env` is refused — `default` is the
# reserved name of the implicit account, i.e. whatever credentials
# env/global.env already exports.
#
# Nothing here takes effect until ACCOUNT_ROUTING=1 is set in env/global.env.
# Full runbook, including how to create the credential: docs/ACCOUNT-ROUTING.md.

# REQUIRED. [a-z0-9][a-z0-9._-]{0,39}; it becomes a filename under state/quota/.
ACCOUNT_NAME=EXAMPLE

# REQUIRED. claude | codex | grok | openrouter | fireworks
ACCOUNT_VENDOR=claude

# 1 (default) or 0. A disabled account stays registered and visible in
# bin/quota-status.sh but is never picked.
ACCOUNT_ENABLED=1

# Lower number = tried first. Default 50. The implicit `default` account is 100,
# so anything below 100 is preferred over today's credentials.
ACCOUNT_PRIORITY=50

# Optional comma-separated allowlist of model slugs this account may serve.
# Empty (or absent) = any model. Example: claude-opus-5,claude-fable-5-1
ACCOUNT_MODELS=

# Human label — shown by quota-status.sh and used as the cost-row account name
# fallback. NEVER a secret; the login e-mail is the usual choice.
ACCOUNT_LABEL=example@example.com

# --- the credential, in the form the vendor's CLI already understands ---------
# Exactly one form per account. The picker EXPORTS what this file sets and
# UNSETS every other credential variable of the vendor in the child, because the
# claude CLI prefers an env CLAUDE_CODE_OAUTH_TOKEN over a config-dir login.
#
# claude, full login (PREFERRED — the usage endpoint is readable, so this
# account gets real 5-hour / weekly / per-model numbers):
#   CLAUDE_CONFIG_DIR=/root/.claude-EXAMPLE   # after `CLAUDE_CONFIG_DIR=... claude login`
# claude, setup-token (works for calls; quota reads back as "unreadable", so
# routing falls back to cooldowns only for this account):
#   CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# claude, API key (metered):
#   ANTHROPIC_API_KEY=sk-ant-api03-...
# codex:
#   CODEX_HOME=/root/.codex-EXAMPLE           # after `CODEX_HOME=... codex login`
#   CODEX_API_KEY=...   OPENAI_API_KEY=...
# grok:        XAI_API_KEY=...
# openrouter:  OPENROUTER_API_KEY=...
# fireworks:   FIREWORKS_API_KEY=...
CLAUDE_CONFIG_DIR=/root/.claude-EXAMPLE
