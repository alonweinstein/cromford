# fly/warm-env/project-4.env — DUMMY VALUES ONLY.
# Sourced (set -a) while baking the warm builder image. This file is baked into
# a registry image: NEVER put a real secret here.
TURSO_DATABASE_URL=file:./warm-bake.db
TURSO_AUTH_TOKEN=
DATABASE_URL=file:./warm-bake.db
CRON_SECRET=test-cron-secret
ANTHROPIC_API_KEY=test-key
CLERK_SECRET_KEY=test-key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
RESEND_API_KEY=test-resend
# Override the repo build script: project-4's `build` runs
# scripts/migrate/run-data-migrations.ts before next build — an image bake must
# NEVER execute a data-migration script (and with dummy env it would only
# abort the bake). prisma generate + next build is the cacheable part.
# next.config.ts sets typescript.ignoreBuildErrors, so this matches CI's split
# (tsc runs in its own workflow, not inside next build).
WARM_BUILD_CMD="corepack pnpm exec prisma generate && corepack pnpm exec next build"
