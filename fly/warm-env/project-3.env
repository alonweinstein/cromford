# fly/warm-env/project-3.env — DUMMY VALUES ONLY.
# Sourced (set -a) while baking the warm builder image so `next build` can run
# at image-build time. Mirrors the repo's own CI dummy-env pattern
# (.github/workflows/e2e.yml). This file is baked into a registry image:
# NEVER put a real secret here.
PREVIEW_MODE=true
TURSO_DATABASE_URL=file:./warm-bake.db
TURSO_AUTH_TOKEN=
CRON_SECRET=test-cron-secret
ANTHROPIC_API_KEY=test-key
TRIAGE_DISABLED=1
CLERK_SECRET_KEY=test-key
CLERK_WEBHOOK_SECRET=whsec_dGVzdC1jbGVyay1zZWNyZXQ=
STRIPE_WEBHOOK_SECRET=whsec_test
CHECKOUT_DOWNLOAD_SECRET=test-checkout-secret
RESEND_API_KEY=test-resend
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Override the repo build script: skip its vitest leg (a test run against dummy
# env earns nothing at bake time — we want the compile caches), keep the exact
# next build invocation (heap bump + --webpack) so the baked .next/cache matches
# what run-build produces on the machine.
WARM_BUILD_CMD="corepack pnpm exec prisma generate && NODE_OPTIONS=--max-old-space-size=7168 corepack pnpm exec next build --webpack"
