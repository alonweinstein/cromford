# fly/warm-env/project-1.env — DUMMY VALUES ONLY.
# Sourced (set -a) while baking the warm builder image. This file is baked into
# a registry image: NEVER put a real secret here.
# project-1 has no dummy-env CI workflow (its deploy builds with real Vercel
# env), so these are best-effort generics; if `next build` still refuses under
# dummy env, the bake keeps checkout+node_modules (the bulk of the win) and
# marks .warm-build-failed.
DATABASE_URL=postgresql://warm:warm@localhost:5432/warm
DIRECT_URL=postgresql://warm:warm@localhost:5432/warm
CRON_SECRET=test-cron-secret
ANTHROPIC_API_KEY=test-key
CLERK_SECRET_KEY=test-key
CLERK_WEBHOOK_SECRET=whsec_dGVzdC1jbGVyay1zZWNyZXQ=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
RESEND_API_KEY=test-resend
SKIP_ENV_VALIDATION=1
