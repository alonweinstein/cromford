{
 "permissions": {
  "allow": [
   "mcp__codegraph__*"
  ]
 },
 "hooks": {
  "UserPromptSubmit": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "codegraph prompt-hook"
     }
    ]
   }
  ],
  "PreToolUse": [
   {
    "matcher": "Bash",
    "hooks": [
     {
      "type": "command",
      "command": "/usr/local/bin/rtk hook claude",
      "timeout": 5
     }
    ]
   },
   {
    "matcher": "Read|Grep|Bash",
    "hooks": [
     {
      "type": "command",
      "command": "/root/harness/bin/secret-read-guard.py",
      "timeout": 10
     }
    ]
   }
  ]
 },
 "enabledPlugins": {
  "vercel@claude-plugins-official": true
 },
 "extraKnownMarketplaces": {
  "claude-plugins-official": {
   "source": {
    "source": "github",
    "repo": "anthropics/claude-plugins-official"
   }
  }
 },
 "theme": "dark"
}